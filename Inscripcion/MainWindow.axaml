<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="760"
        d:DesignHeight="760"
        x:Class="Inscripcion.MainWindow"
        Title="Inscripción al curso"
        Width="760"
        Height="760"
        MinHeight="600"
        MinWidth="600">
        <Border BorderBrush="black" BorderThickness="1">
                <Grid RowDefinitions="Auto,*" Background="Darkgray">
                        <Border Grid.Row="0" Background="DimGray" Padding="22,16">
                                <StackPanel Spacing="4">
                                        <TextBlock Text="Inscripción al curso" FontSize="24" Foreground="black" FontWeight="Bold"/>
                                        <TextBlock Text="IES El Majuelo - Formación complementaria" FontSize="14" Foreground="white"/>
                                </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20" Spacing="12">
                                        <Border Background="lightgray" BorderBrush="black" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel Spacing="10">
                                                        <TextBlock Text="Datos personales" FontSize="17" Foreground="black" FontWeight="Bold"/>
                                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="160,*" RowSpacing="8" ColumnSpacing="10">
                                                        <TextBlock Text="Nombre" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" PlaceholderText="Tu nombre"/>
                                                        <TextBlock Grid.Row="1" Text="Apellidos" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="Tu apellido"/>
                                                        <TextBlock Grid.Row="2" Text="Fecha de nacimiento" VerticalAlignment="Center"/>
                                                        <DatePicker Grid.Row="2" Grid.Column="1"/>
                                                        <TextBlock Grid.Row="3" Text="Correo electrónico" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1" PlaceholderText="nombre@correo.com"/>
                                                        </Grid>
                                                </StackPanel>
                                        </Border>
                                        <Border Background="lightgray" BorderBrush="black" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel Spacing="10">
                                                        <TextBlock Text="Curso" FontSize="17" Foreground="black" FontWeight="Bold"/>
                                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="130,*" RowSpacing="10" ColumnSpacing="10">
                                                                <TextBlock Text="Curso" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="1">
                                                                        <ComboBoxItem Content="Desarrollo de interfaces con Avalonia" IsSelected="True" />
                                                                        <ComboBoxItem Content="Desarrollo Web Inicial"/>
                                                                        <ComboBoxItem Content="Programación (Java)"/>
                                                                        <ComboBoxItem Content="Base de datos"/>
                                                                </ComboBox>
                                                                <TextBlock Grid.Row="1" Text="Modalidad" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="15">
                                                                        <RadioButton Content="Presencial" IsChecked="True"/>
                                                                        <RadioButton Content="Online"/>
                                                                </StackPanel>
                                                        </Grid>
                                                </StackPanel>
                                        </Border>
                                        <Border Background="lightgray" BorderBrush="black" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel Spacing="12">
                                                        <TextBlock Text="Preferencias" FontSize="17" Foreground="black" FontWeight="Bold"/>
                                                        <Grid ColumnDefinitions="90,*">
                                                                <TextBlock Text="Intereses" VerticalAlignment="Center"/>
                                                                <UniformGrid Grid.Column="1" Columns="3">
                                                                        <CheckBox Content="Programación" IsChecked="True"/>
                                                                        <CheckBox Content="Diseño" IsChecked="True"/>
                                                                        <CheckBox Content="Bases de datos"/>
                                                                        <CheckBox Content="Redes"/>
                                                                        <CheckBox Content="Móvil"/>
                                                                        <CheckBox Content="Videojuegos"/>
                                                                </UniformGrid>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="5">
                                                                <TextBlock Text="Nivel (1 a 5)" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" Value="3" TickFrequency="1" Foreground="black" Background="black"  />
                                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="1 = principiante · 5 = avanzado" FontSize="11" Foreground="Gray"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*">
                                                                <TextBlock Text="Novedades" VerticalAlignment="Center"/>
                                                                <ToggleSwitch Grid.Column="1" IsChecked="True" OffContent="Quiero recibir novedades por correo" OnContent="Quiero recibir novedades por correo"/>
                                                        </Grid>
                                                </StackPanel>
                                        </Border>
                                        <Border Background="lightgray" BorderBrush="black" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                                <StackPanel Spacing="10">
                                                        <TextBlock Text="Observaciones" FontSize="17" Foreground="black" FontWeight="Bold"/>
                                                        <TextBox PlaceholderText="Escribe aquí cualquier comentario..." AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" Height="150"/>
                                                        <TextBlock Text="Máximo 500 caracteres." Foreground="Gray" FontSize="11"/>
                                                </StackPanel>
                                        </Border>
                                        <Border Background="lightgray" BorderBrush="black" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <Grid ColumnDefinitions="auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="10">
                                                        <TextBlock Grid.ColumnSpan="2" Text="Horario y facturación" FontSize="17" Foreground="black" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="0" Text="Horario preferido" Grid.Row="1" />
                                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">                                                        
                                                                <TextBlock Grid.Column="1" Text="Lun" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="Mar" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="Mié" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="Jue" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="5" Text="Vie" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Row="1" Text="Mañana" VerticalAlignment="Center" Grid.Column="0"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" IsChecked="True"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" IsChecked="True"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" IsChecked="True"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" IsChecked="True"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Center" IsChecked="True"/>
                                                                <TextBlock Grid.Row="2" Text="Tarde" VerticalAlignment="Center" Grid.Column="0"/>
                                                                <CheckBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="2" Grid.Column="4" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Row="3" Text="Noche" VerticalAlignment="Center" Grid.Column="0"/>
                                                                <CheckBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="3" Grid.Column="4" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="3" Grid.Column="5" HorizontalAlignment="Center"/>
                                                                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Content="Cualquier horario"/>
                                                        </Grid>
                                                        <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="Datos de facturación (opcional)" IsExpanded="True" HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10" Margin="5,10,5,5">
                                                                        <TextBlock Text="NIF / CIF" VerticalAlignment="Center"/>
                                                                        <TextBox Grid.Column="1" PlaceholderText="Ej: 12345678A"/>
                                                                        <TextBlock Grid.Row="1" Text="Dirección" VerticalAlignment="Center"/>
                                                                        <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="Calle y número"/>
                                                                        <TextBlock Grid.Row="2" Text="CP y población" VerticalAlignment="Center"/>
                                                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="auto,*" ColumnSpacing="5">
                                                                                <TextBox Grid.Column="0" PlaceholderText="CP"/>
                                                                                <TextBox Grid.Column="1" PlaceholderText="Población"/>
                                                                        </Grid>
                                                                        <TextBlock Grid.Row="3" Text="Forma de pago" VerticalAlignment="Center"/>
                                                                        <ComboBox Grid.Row="3" Grid.Column="1">
                                                                                <ComboBoxItem Content="Tarjeta" IsSelected="True" />
                                                                                <ComboBoxItem Content="Transferencia"/>  
                                                                                <ComboBoxItem Content="Efectivo"/>
                                                                        </ComboBox>
                                                                        <TextBlock Grid.Row="4" Text="Plazos" VerticalAlignment="Center"/>
                                                                        <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="12" Value="1" FormatString="0" Width="100" HorizontalAlignment="Left"/>
                                                                </Grid>
                                                        </Expander>
                                                        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="lightgray" BorderBrush="black" BorderThickness="1" Padding="10">
                                                                <DockPanel LastChildFill="True">
                                                                        <TextBlock Text="240,00 €" DockPanel.Dock="Right" FontSize="16" FontWeight="Bold" Foreground="red" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Importe estimado" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                        </Border>
                                                </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,10" Spacing="10">
                                                <Button Content="Limpiar" Background="white" Foreground="black" Padding="20,10" CornerRadius="6" Width="110" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                <Button Content="Enviar" Background="black" Foreground="White" Padding="20,10" CornerRadius="6" Width="110" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                </StackPanel>
                        </ScrollViewer>
                </Grid>
        </Border>
</Window>
